# Database Configuration
# Match the credentials in docker-compose.yml
# Using postgresql+psycopg for synchronous connections
DATABASE_URL=postgresql+psycopg://mise_user:mise_password@localhost:5432/mise

# Test Database (used by pytest)
TEST_DATABASE_URL=postgresql+psycopg://mise_user:mise_password@localhost:5432/mise_test

# Set to False in production
SQLALCHEMY_ECHO=True

# File storage path
FILE_STORAGE_PATH=/data/mise/files

# Anthropic AI Configuration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here
AI_MODEL=claude-haiku-4-5-20251001
AI_MAX_TOKENS=4096
