# Mise Production Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection details
POSTGRES_USER=mise_user
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=mise

# Full database URL (auto-constructed from above values)
DATABASE_URL=postgresql+psycopg://mise_user:mise_password@postgres:5432/mise

# Database settings
SQLALCHEMY_ECHO=False

# =============================================================================
# API SECURITY
# =============================================================================
# API secret key for session encryption (generate with: openssl rand -hex 32)
API_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# Comma-separated list of valid API keys for authentication
# Generate keys with: openssl rand -hex 32
# Example: API_KEYS=key1,key2,key3
API_KEYS=CHANGE_ME_YOUR_API_KEY

# CORS origins (only needed if you have a web frontend)
# Leave empty to disable CORS (most secure for API-only usage)
# If you add a web UI later, set to your domain(s):
# Example: API_CORS_ORIGINS=https://mise.elidibus.com,https://www.elidibus.com
API_CORS_ORIGINS=

# =============================================================================
# AI CONFIGURATION
# =============================================================================
# Anthropic API key for Claude access
# Get yours from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=CHANGE_ME_YOUR_ANTHROPIC_KEY

# AI model to use for recipe extraction
# Options: claude-haiku-4-5-20251001 (fast, cheap), claude-sonnet-4-5-20250514 (best)
AI_MODEL=claude-haiku-4-5-20251001

# Maximum tokens for AI responses
AI_MAX_TOKENS=4096

# =============================================================================
# FILE STORAGE
# =============================================================================
# Path for storing uploaded files and recipe images
FILE_STORAGE_PATH=/data/files

# =============================================================================
# WORKER CONFIGURATION
# =============================================================================
# Unique identifier for this worker instance
WORKER_ID=worker-1

# How often the worker checks for new jobs (seconds)
WORKER_POLL_INTERVAL=5

# =============================================================================
# LOGGING
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# NGINX CONFIGURATION
# =============================================================================
# Domain name for your deployment (used for SSL certificates)
DOMAIN=mise.yourdomain.com

# HTTP port (80 for standard, or custom port)
NGINX_HTTP_PORT=80

# HTTPS port (443 for standard, or custom port)
NGINX_HTTPS_PORT=443

# =============================================================================
# TIMEZONE
# =============================================================================
# Timezone for logs and scheduled tasks
# Examples: America/Toronto, America/New_York, Europe/London, UTC
TZ=America/Toronto

# =============================================================================
# OPTIONAL: EMAIL NOTIFICATIONS (Future enhancement)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# NOTIFICATION_EMAIL=admin@yourdomain.com
